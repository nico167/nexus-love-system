# MongoDB — local con Docker: mongodb://localhost:27017/nexus-love-system
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nexus-love-system?retryWrites=true&w=majority
# Nota: Prisma requiere replica set para operaciones de escritura. Usa `docker compose up -d` en local.
DATABASE_URL="mongodb://localhost:27017/nexus-love-system"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Seed credentials (optional — defaults shown in seed.ts)
SEED_ADMIN_EMAIL="admin@nexus.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_VIP_EMAIL="vip@nexus.local"
SEED_VIP_PASSWORD="14022024"

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=api_key_aqui
CLOUDINARY_API_SECRET=tu_nuevo_secret_rotado
